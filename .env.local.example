# Bulacio Bienes Raíces — plantilla de variables de entorno
#
# Uso:  cp .env.local.example .env.local
# Después completá cada valor con tus credenciales.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).

# ---------------------------------------------------------------
# Supabase
# Panel → Settings → API
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# Mapbox
# https://account.mapbox.com/access-tokens/
# Sin token, el mapa del detalle de propiedad no se renderiza
# (el resto del sitio funciona normalmente).
# ---------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---------------------------------------------------------------
# URL canónica del sitio
# Producción: dominio definitivo (o el *.vercel.app del proyecto)
# Ojo: NO usar la URL del deploy puntual (la que lleva un hash
# tipo -l3jdg7l40-), ya que cambia en cada despliegue.
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
